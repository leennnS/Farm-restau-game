<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

    <!-- Fullscreen root -->
    <ui:VisualElement name="hotbarRoot" style="
         position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    height: 80px;
    align-items: center;
    justify-content: flex-end;
        padding-bottom: 16px;
        picking-mode: ignore;">

        <!-- Hotbar container -->
        <ui:VisualElement name="hotbarContainer" style="
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 8px 10px;
            background-color: rgba(228, 183, 122, 0.85);
            border-left-width: 3px; border-right-width: 3px;
            border-top-width: 3px; border-bottom-width: 3px;
            border-left-color: rgb(139, 90, 43);
            border-right-color: rgb(139, 90, 43);
            border-top-color: rgb(192, 138, 74);
            border-bottom-color: rgb(107, 63, 26);
            ">

            <!-- Numbers row -->
            <ui:VisualElement name="hotbarNumbers" style="flex-direction: row; gap: 8px; margin-bottom: 2px;">
                <ui:Label text="1" style="width: 36px; text-align: center; font-size: 10px; unity-font-style: bold; color: rgb(58,42,24);" />
                <ui:Label text="2" style="width: 36px; text-align: center; font-size: 10px; unity-font-style: bold; color: rgb(58,42,24);" />
                <ui:Label text="3" style="width: 36px; text-align: center; font-size: 10px; unity-font-style: bold; color: rgb(58,42,24);" />
                <ui:Label text="4" style="width: 36px; text-align: center; font-size: 10px; unity-font-style: bold; color: rgb(58,42,24);" />
                <ui:Label text="5" style="width: 36px; text-align: center; font-size: 10px; unity-font-style: bold; color: rgb(58,42,24);" />
                <ui:Label text="6" style="width: 36px; text-align: center; font-size: 10px; unity-font-style: bold; color: rgb(58,42,24);" />
                <ui:Label text="7" style="width: 36px; text-align: center; font-size: 10px; unity-font-style: bold; color: rgb(58,42,24);" />
                <ui:Label text="8" style="width: 36px; text-align: center; font-size: 10px; unity-font-style: bold; color: rgb(58,42,24);" />
                <ui:Label text="9" style="width: 36px; text-align: center; font-size: 10px; unity-font-style: bold; color: rgb(58,42,24);" />
                <ui:Label text="10" style="width: 36px; text-align: center; font-size: 10px; unity-font-style: bold; color: rgb(58,42,24);" />
                <ui:Label text="11" style="width: 36px; text-align: center; font-size: 10px; unity-font-style: bold; color: rgb(58,42,24);" />
                <ui:Label text="12" style="width: 36px; text-align: center; font-size: 10px; unity-font-style: bold; color: rgb(58,42,24);" />
            </ui:VisualElement>

            <!-- Slots row -->
            <ui:VisualElement name="hotbarSlots" style="flex-direction: row; gap: 8px;">
                <ui:VisualElement name="hotbarSlot01" style="width: 36px; height: 36px; background-color: rgb(242,228,199);
                    border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
                    border-left-color: rgb(199,167,122); border-right-color: rgb(199,167,122);
                    border-top-color: rgb(231,207,160); border-bottom-color: rgb(155,107,60);" />
                <ui:VisualElement name="hotbarSlot02" style="width: 36px; height: 36px; background-color: rgb(242,228,199); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(199,167,122); border-right-color: rgb(199,167,122); border-top-color: rgb(231,207,160); border-bottom-color: rgb(155,107,60);" />
                <ui:VisualElement name="hotbarSlot03" style="width: 36px; height: 36px; background-color: rgb(242,228,199); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(199,167,122); border-right-color: rgb(199,167,122); border-top-color: rgb(231,207,160); border-bottom-color: rgb(155,107,60);" />
                <ui:VisualElement name="hotbarSlot04" style="width: 36px; height: 36px; background-color: rgb(242,228,199); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(199,167,122); border-right-color: rgb(199,167,122); border-top-color: rgb(231,207,160); border-bottom-color: rgb(155,107,60);" />
                <ui:VisualElement name="hotbarSlot05" style="width: 36px; height: 36px; background-color: rgb(242,228,199); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(199,167,122); border-right-color: rgb(199,167,122); border-top-color: rgb(231,207,160); border-bottom-color: rgb(155,107,60);" />
                <ui:VisualElement name="hotbarSlot06" style="width: 36px; height: 36px; background-color: rgb(242,228,199); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(199,167,122); border-right-color: rgb(199,167,122); border-top-color: rgb(231,207,160); border-bottom-color: rgb(155,107,60);" />
                <ui:VisualElement name="hotbarSlot07" style="width: 36px; height: 36px; background-color: rgb(242,228,199); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(199,167,122); border-right-color: rgb(199,167,122); border-top-color: rgb(231,207,160); border-bottom-color: rgb(155,107,60);" />
                <ui:VisualElement name="hotbarSlot08" style="width: 36px; height: 36px; background-color: rgb(242,228,199); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(199,167,122); border-right-color: rgb(199,167,122); border-top-color: rgb(231,207,160); border-bottom-color: rgb(155,107,60);" />
                <ui:VisualElement name="hotbarSlot09" style="width: 36px; height: 36px; background-color: rgb(242,228,199); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(199,167,122); border-right-color: rgb(199,167,122); border-top-color: rgb(231,207,160); border-bottom-color: rgb(155,107,60);" />
                <ui:VisualElement name="hotbarSlot10" style="width: 36px; height: 36px; background-color: rgb(242,228,199); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(199,167,122); border-right-color: rgb(199,167,122); border-top-color: rgb(231,207,160); border-bottom-color: rgb(155,107,60);" />
                <ui:VisualElement name="hotbarSlot11" style="width: 36px; height: 36px; background-color: rgb(242,228,199); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(199,167,122); border-right-color: rgb(199,167,122); border-top-color: rgb(231,207,160); border-bottom-color: rgb(155,107,60);" />
                <ui:VisualElement name="hotbarSlot12" style="width: 36px; height: 36px; background-color: rgb(242,228,199); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(199,167,122); border-right-color: rgb(199,167,122); border-top-color: rgb(231,207,160); border-bottom-color: rgb(155,107,60);" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
