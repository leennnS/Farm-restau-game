.cook-button {
    width: 120px;
    height: 40px;
    margin-top: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(92, 45, 12);

    background-color: rgb(255, 212, 94);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(224, 166, 38);
    border-right-color: rgb(194, 132, 17);
    border-top-color: rgb(255, 237, 154);
    border-bottom-color: rgb(155, 97, 8);

    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;

    unity-text-align: middle-center;
    letter-spacing: 0.5px;
}

.cook-button:hover {
    background-color: rgb(255, 224, 120);
    border-top-color: rgb(255, 245, 180);
    border-bottom-color: rgb(170, 105, 10);
}

.cook-button:active {
    background-color: rgb(235, 182, 60);
    border-top-color: rgb(255, 220, 120);
    border-bottom-color: rgb(130, 78, 8);
}

.back-button {
    width: 84px;
    height: 34px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(80, 52, 28);

    background-color: rgb(230, 212, 186);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(176, 144, 108);
    border-right-color: rgb(150, 118, 82);
    border-top-color: rgb(246, 230, 210);
    border-bottom-color: rgb(128, 92, 60);

    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;

    unity-text-align: middle-center;
}

.back-button:hover {
    background-color: rgb(240, 224, 200);
}

.back-button:active {
    background-color: rgb(208, 188, 162);
}

.cooking-loading-container {
    display: none;
    flex-direction: column;
    gap: 6px;
    margin-top: 8px;
    margin-bottom: 4px;
    padding: 10px;

    background-color: rgb(248, 237, 214);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(199, 167, 122);
    border-right-color: rgb(199, 167, 122);
    border-top-color: rgb(231, 207, 160);
    border-bottom-color: rgb(155, 107, 60);

    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.cooking-loading-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(58, 42, 24);
    unity-text-align: middle-center;
}

.cooking-loading-bar-background {
    position: relative;
    width: 100%;
    height: 22px;
    background-color: rgb(231, 217, 190);

    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(180, 145, 100);
    border-right-color: rgb(180, 145, 100);
    border-top-color: rgb(245, 230, 210);
    border-bottom-color: rgb(160, 125, 80);

    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;

    overflow: hidden;
}

.cooking-loading-bar-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(255, 196, 70);

    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

.cooking-progress-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 2px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(92, 45, 12);
    unity-text-align: middle-center;
}