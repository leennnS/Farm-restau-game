.cook-button {
    width: 108px;
    height: 34px;
    margin-top: 4px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(92, 45, 12);

    background-color: rgb(255, 212, 94);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(224, 166, 38);
    border-right-color: rgb(194, 132, 17);
    border-top-color: rgb(255, 237, 154);
    border-bottom-color: rgb(155, 97, 8);

    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;

    -unity-text-align: middle-center;
}

.cook-button:hover {
    background-color: rgb(255, 224, 120);
    border-top-color: rgb(255, 245, 180);
    border-bottom-color: rgb(170, 105, 10);
}

.cook-button:active {
    background-color: rgb(235, 182, 60);
    border-top-color: rgb(255, 220, 120);
    border-bottom-color: rgb(130, 78, 8);
}

.back-button {
    width: 84px;
    height: 32px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(80, 52, 28);

    background-color: rgb(230, 212, 186);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(176, 144, 108);
    border-right-color: rgb(150, 118, 82);
    border-top-color: rgb(246, 230, 210);
    border-bottom-color: rgb(128, 92, 60);

    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;

    -unity-text-align: middle-center;
}

.back-button:hover {
    background-color: rgb(240, 224, 200);
}

.back-button:active {
    background-color: rgb(208, 188, 162);
}

.cooking-loading-container {
    display: none;
    width: 130px;
    margin-top: 4px;
    margin-bottom: 0;
    margin-left: 6px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;

    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;

    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    gap: 3px;
}

.cooking-loading-label {
    display: flex;
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(92, 60, 32);
    unity-text-align: middle-left;
}

.cooking-loading-bar-background {
    position: relative;
    width: 100%;
    height: 8px;
    background-color: rgba(92, 60, 32, 0.22);

    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;

    overflow: hidden;
}

.cooking-loading-bar-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(255, 196, 70);

    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

.cooking-progress-text {
    display: flex;
    font-size: 8px;
    -unity-font-style: bold;
    color: rgb(110, 78, 42);
    unity-text-align: middle-right;
}

.top-tab {
    width: 36px;
    height: 36px;
    margin-top: 6px;

    background-color: rgb(214, 168, 107);
    background-size: 20px 20px;
    background-position: center;
    background-repeat: no-repeat;

    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;

    border-left-color: rgb(122, 78, 42);
    border-right-color: rgb(122, 78, 42);
    border-top-color: rgb(183, 126, 62);
    border-bottom-color: rgb(92, 58, 27);

    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

.top-tab:hover {
    background-color: rgb(228, 183, 122);
}

.active-top-tab {
    height: 40px;
    margin-top: 2px;
    background-color: rgb(228, 183, 122);

    border-left-color: rgb(139, 90, 43);
    border-right-color: rgb(139, 90, 43);
    border-top-color: rgb(192, 138, 74);
    border-bottom-color: rgb(228, 183, 122);
}

.category-tab {
    min-width: 82px;
    height: 26px;
    margin-top: 4px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 246, 232);

    background-color: rgb(118, 83, 50);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(88, 61, 35);
    border-right-color: rgb(88, 61, 35);
    border-top-color: rgb(164, 120, 74);
    border-bottom-color: rgb(60, 40, 22);

    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;

    -unity-text-align: middle-center;
}

.category-tab .unity-text-element {
    white-space: nowrap;
    unity-text-align: middle-center;
}

.category-tab:hover {
    background-color: rgb(134, 97, 58);
    border-top-color: rgb(191, 146, 92);
}

.category-tab:active {
    background-color: rgb(93, 64, 37);
    border-top-color: rgb(143, 104, 63);
    border-bottom-color: rgb(39, 27, 15);
    margin-top: 5px;
}

.active-category-tab {
    height: 28px;
    margin-top: 2px;
    color: rgb(74, 42, 14);
    background-color: rgb(248, 214, 129);
    border-left-color: rgb(207, 149, 49);
    border-right-color: rgb(168, 117, 31);
    border-top-color: rgb(255, 239, 173);
    border-bottom-color: rgb(142, 91, 15);
}