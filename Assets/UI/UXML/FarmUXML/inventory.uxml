   <ui:VisualElement name="inventoryRoot" style="flex-grow: 1; align-items: center; justify-content: center;">
    <ui:VisualElement name="inventoryShell" style="width: 820px; position: relative;">
        <ui:VisualElement name="inventoryTabs" style="flex-direction: row; gap: 4px; margin-left: 12px; margin-bottom: -2px; height: 42px; align-items: flex-end;">
            <ui:Button name="tabToolsButton" tooltip="Inventory" class="top-tab active-top-tab" style="background-image: url(&quot;project://database/Assets/Art/Models/Farm/InventoryIcons/sprout.png?fileID=2800000&amp;guid=fcf461b16c4d1854a90e415ee4a4dd7a&amp;type=3#sprout&quot;);" />
            <ui:Button name="tabMapButton" tooltip="Map" class="top-tab" style="background-image: url(&quot;project://database/Assets/Art/Sprites/treasure-map.png?fileID=2800000&amp;guid=8c51cb2da6ed9e34bb4064cded81d6ca&amp;type=3#treasure-map&quot;);" />
            <ui:Button name="tabCraftingButton" tooltip="Crafting" class="top-tab" style="background-image: url(&quot;project://database/Assets/Art/Models/Farm/InventoryIcons/chef.png?fileID=2800000&amp;guid=4e9ff1eb3a15b1c4a9250d071b56d496&amp;type=3#chef&quot;);" />
            <ui:Button name="tabSettingsButton" tooltip="Settings" class="top-tab" style="background-image: url(&quot;project://database/Assets/Art/Sprites/cogwheel.png?fileID=2800000&amp;guid=56a62a677ee29354c8af0689dfd1e769&amp;type=3#cogwheel&quot;);" />
        </ui:VisualElement>

        <ui:VisualElement name="inventoryPanel" style="width: 820px; height: 560px; background-color: rgb(228, 183, 122); border-left-color: rgb(139, 90, 43); border-right-color: rgb(139, 90, 43); border-top-color: rgb(192, 138, 74); border-bottom-color: rgb(107, 63, 26); border-left-width: 4px; border-right-width: 4px; border-top-width: 4px; border-bottom-width: 4px; padding-left: 18px; padding-right: 18px; padding-top: 14px; padding-bottom: 14px; min-height: auto;">
            <ui:VisualElement name="inventoryHeader" style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <ui:Label text="Inventory" name="Title" style="font-size: 28px; unity-font-style: bold; color: rgb(58, 42, 24);"/>
                <ui:Button name="closeButton" text="X" style="width: 40px; height: 40px; font-size: 20px;"/>
            </ui:VisualElement>
           
