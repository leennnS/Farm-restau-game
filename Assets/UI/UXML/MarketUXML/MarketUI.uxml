<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/UXML/MarketUI.uss?fileID=7433441132597879392&amp;guid=75a8cfac75476704cb4fd11a5816d999&amp;type=3#MarketUI"/>
    <ui:VisualElement name="screen-root" class="screen-root">
        <ui:VisualElement name="market-root" class="market-root hidden">
            <ui:VisualElement class="market-backdrop"/>
            <ui:VisualElement class="market-window">
                <ui:VisualElement class="market-topbar">
                    <ui:VisualElement class="brand-block">
                        <ui:Label name="market-title" text="Village Supermarket" class="market-title"/>
                        <ui:Label name="market-subtitle" text="Browse and buy what you need." class="market-subtitle"/>
                    </ui:VisualElement>
                    <ui:Button name="close-button" text="Close" class="close-button"/>
                </ui:VisualElement>
                <ui:VisualElement class="market-body">
                    <ui:VisualElement class="category-rail">
                        <ui:Label text="Sections" class="rail-title"/>
                        <ui:ScrollView mode="Vertical" class="category-scroll">
                            <ui:Button name="tab-seeds" text="Seeds" class="category-button seeds-button"/>
                            <ui:Button name="tab-tools" text="Tools" class="category-button tools-button"/>
                            <ui:Button name="tab-fruits-vegetables" text="Fruits &amp; Vegetables" class="category-button fruits-vegetables-button"/>
                            <ui:Button name="tab-fish-seafood" text="Fish &amp; Seafood" class="category-button fish-seafood-button"/>
                            <ui:Button name="tab-meat-poultry" text="Meat &amp; Poultry" class="category-button meat-poultry-button"/>
                            <ui:Button name="tab-drinks" text="Drinks" class="category-button drinks-button"/>
                            <ui:Button name="tab-baking-dairy" text="Bread Dairy&#10;Sweeteners" class="category-button baking-dairy-button"/>
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <ui:VisualElement class="section-stage">
                        <ui:VisualElement name="section-seeds" class="section-panel seeds-theme">
                            <ui:VisualElement class="section-header">
                                <ui:Label text="Seeds" class="section-title"/>
                                <ui:Label text="Grow your next harvest." class="section-description"/>
                            </ui:VisualElement>
                            <ui:ScrollView name="scroll-seeds" class="item-scroll">
                                <ui:VisualElement name="grid-seeds" class="items-grid"/>
                            </ui:ScrollView>
                        </ui:VisualElement>
                        <ui:VisualElement name="section-tools" class="section-panel tools-theme hidden">
                            <ui:VisualElement class="section-header">
                                <ui:Label text="Tools" class="section-title"/>
                                <ui:Label text="Reliable gear for farm work." class="section-description"/>
                            </ui:VisualElement>
                            <ui:ScrollView name="scroll-tools" class="item-scroll">
                                <ui:VisualElement name="grid-tools" class="items-grid tools-grid"/>
                            </ui:ScrollView>
                        </ui:VisualElement>
                        <ui:VisualElement name="section-fruits-vegetables" class="section-panel fruits-vegetables-theme hidden">
                            <ui:VisualElement class="section-header">
                                <ui:Label text="Fruits and Vegetables" class="section-title"/>
                                <ui:Label text="Fresh picks for daily meals and recipes." class="section-description"/>
                            </ui:VisualElement>
                            <ui:ScrollView name="scroll-fruits-vegetables" class="item-scroll">
                                <ui:VisualElement name="grid-fruits-vegetables" class="items-grid"/>
                            </ui:ScrollView>
                        </ui:VisualElement>
                        <ui:VisualElement name="section-fish-seafood" class="section-panel fish-seafood-theme hidden">
                            <ui:VisualElement class="section-header">
                                <ui:Label text="Fish and Seafood" class="section-title"/>
                                <ui:Label text="From river and sea, ready for your kitchen." class="section-description"/>
                            </ui:VisualElement>
                            <ui:ScrollView name="scroll-fish-seafood" class="item-scroll">
                                <ui:VisualElement name="grid-fish-seafood" class="items-grid"/>
                            </ui:ScrollView>
                        </ui:VisualElement>
                        <ui:VisualElement name="section-meat-poultry" class="section-panel meat-poultry-theme hidden">
                            <ui:VisualElement class="section-header">
                                <ui:Label text="Meat and Poultry" class="section-title"/>
                                <ui:Label text="Quality cuts for hearty dishes." class="section-description"/>
                            </ui:VisualElement>
                            <ui:ScrollView name="scroll-meat-poultry" class="item-scroll">
                                <ui:VisualElement name="grid-meat-poultry" class="items-grid"/>
                            </ui:ScrollView>
                        </ui:VisualElement>
                        <ui:VisualElement name="section-drinks" class="section-panel drinks-theme hidden">
                            <ui:VisualElement class="section-header">
                                <ui:Label text="Drinks" class="section-title"/>
                                <ui:Label text="Refreshments and juices." class="section-description"/>
                            </ui:VisualElement>
                            <ui:ScrollView name="scroll-drinks" class="item-scroll">
                                <ui:VisualElement name="grid-drinks" class="items-grid"/>
                            </ui:ScrollView>
                        </ui:VisualElement>
                        <ui:VisualElement name="section-baking-dairy" class="section-panel baking-dairy-theme hidden">
                            <ui:VisualElement class="section-header">
                                <ui:Label text="Bread Dairy Sweeteners" class="section-title"/>
                                <ui:Label text="Bread, dairy, and sweeteners for pantry staples." class="section-description"/>
                            </ui:VisualElement>
                            <ui:ScrollView name="scroll-baking-dairy" class="item-scroll">
                                <ui:VisualElement name="grid-baking-dairy" class="items-grid"/>
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="interaction-hint" text="" class="interaction-hint hidden"/>
    </ui:VisualElement>
</ui:UXML>
