/* Cozy rustic fishing mini-game: compact wide panel at bottom center */

.fishing-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-end;
    align-items: center;
    pointer-events: none;
}

.fishing-panel {
    width: 1200px;
    max-width: 92%;
    height: 400px;
    margin-bottom: 28px;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    color: rgb(45, 30, 18);
    position: relative;
    pointer-events: none;
    transition-duration: 0.24s;
    transition-property: opacity, translate;
    opacity: 0;
    translate: 0 22px;
    background-position-x: 50%;
    background-position-y: 50%;
    background-repeat: no-repeat;
    background-size: contain;
    overflow: visible;
}

.fishing-panel-visible {
    opacity: 1;
    translate: 0 0;
}

.fishing-panel-hidden {
    opacity: 0;
    translate: 0 22px;
}

.panel-trim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-width: 0;
    background-color: transparent;
    background-position-x: 50%;
    background-position-y: 50%;
    background-repeat: no-repeat;
    background-size: contain;
}

.track-art {
    position: absolute;
    left: 98px;
    right: 98px;
    top: 142px;
    height: 100px;
    background-color: transparent;
    background-position-x: 50%;
    background-position-y: 50%;
    background-repeat: no-repeat;
    background-size: 100% 100%;
    border-radius: 24px;
}

.panel-header {
    position: absolute;
    left: 82px;
    right: 82px;
    top: 94px;
    height: 30px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0;
}

.header-left {
    flex-direction: row;
    align-items: center;
}

.header-right {
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.header-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(64, 37, 17);
}

.fish-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(49, 31, 18);
}

.rarity-chip {
    min-width: 120px;
    height: 22px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(64, 107, 131, 0.66);
    background-color: rgba(146, 191, 210, 0.48);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(28, 52, 64);
}

.small-icon {
    width: 22px;
    height: 22px;
    margin-right: 8px;
    border-radius: 13px;
    border-width: 1px;
    border-color: rgba(84, 57, 34, 0.72);
    background-color: rgba(243, 236, 213, 0.66);
    background-position-x: 50%;
    background-position-y: 50%;
    background-repeat: no-repeat;
    background-size: contain;
    justify-content: center;
    align-items: center;
}

.icon-glyph {
    font-size: 14px;
    -unity-text-align: middle-center;
    color: rgba(58, 47, 33, 0.92);
    -unity-font-style: bold;
}

.hook-icon {
    background-color: rgba(224, 208, 182, 0.92);
}

.bobber-icon {
    margin-right: 0;
    margin-bottom: 6px;
    align-self: center;
    background-color: rgba(220, 238, 246, 0.92);
}

.panel-content-row {
    position: absolute;
    left: 86px;
    right: 86px;
    top: 142px;
    height: 135px;
    flex-direction: row;
    gap: 0;
}

.track-stack {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-start;
}

.fish-track {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 0px;
    height: 100px;
    border-radius: 24px;
    border-width: 0;
    background-color: transparent;
    overflow: visible;
    margin-bottom: 0;
    background-position-x: 50%;
    background-position-y: 50%;
    background-repeat: no-repeat;
    background-size: contain;
}

.water-strip {
    display: none;
}

.water-bubble {
    display: none;
}

.bubble-a {
    left: 13%;
    top: 24%;
}

.bubble-b {
    left: 51%;
    top: 67%;
}

.bubble-c {
    left: 82%;
    top: 36%;
}

.catch-zone {
    position: absolute;
    top: 10px;
    bottom: 10px;
    width: 160px;
    left: 120px;
    border-radius: 11px;
    border-width: 2px;
    border-color: rgba(240, 238, 214, 0.92);
    background-color: rgba(174, 218, 140, 0.36);
}

.fish-target {
    position: absolute;
    top: 29px;
    width: 42px;
    height: 42px;
    left: 120px;
    border-radius: 21px;
    border-width: 2px;
    border-color: rgba(56, 93, 118, 0.9);
    background-color: rgba(195, 225, 239, 0.92);
    justify-content: center;
    align-items: center;
    background-position-x: 50%;
    background-position-y: 50%;
    background-repeat: no-repeat;
    background-size: contain;
}

.fish-glyph {
    font-size: 23px;
    -unity-font-style: bold;
    color: rgba(33, 66, 89, 0.95);
    -unity-text-align: middle-center;
}

.meter-block {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    flex-direction: column;
    gap: 5px;
}

.meter-label-row {
    flex-direction: row;
    justify-content: space-between;
}

.meter-label {
    width: 49%;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(72, 46, 22);
}

.meter-row {
    flex-direction: row;
    justify-content: space-between;
}

.meter-bg {
    width: 49%;
    height: 16px;
    border-radius: 8px;
    border-width: 1px;
    overflow: hidden;
}

.catch-meter-bg {
    background-color: rgba(151, 195, 145, 0.4);
    border-color: rgba(73, 114, 64, 0.8);
}

.tension-meter-bg {
    background-color: rgba(226, 149, 115, 0.36);
    border-color: rgba(135, 62, 46, 0.82);
}

.meter-fill {
    height: 100%;
    width: 0%;
}

.catch-fill {
    background-color: rgba(105, 171, 80, 0.95);
}

.tension-fill {
    background-color: rgba(198, 78, 60, 0.95);
}

.side-column {
    position: absolute;
    right: 0;
    top: 78px;
    width: 345px;
    height: 50px;
    border-width: 0;
    background-color: transparent;
    padding: 0;
    justify-content: flex-start;
    align-items: flex-end;
}

.input-hint {
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(52, 64, 77);
    margin-bottom: 2px;
    white-space: normal;
}

.status-label {
    min-height: 18px;
    font-size: 10px;
    -unity-text-align: middle-right;
    color: rgba(66, 46, 25, 0.78);
    white-space: normal;
}

.result-chip {
    position: absolute;
    right: 22px;
    top: -14px;
    min-width: 190px;
    height: 36px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(68, 44, 26, 0.88);
    padding-left: 12px;
    padding-right: 12px;
    justify-content: center;
    align-items: center;
    background-color: rgba(222, 203, 167, 0.96);
    display: none;
}

.result-text {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(50, 31, 17);
}

.result-success {
    background-color: rgba(163, 213, 142, 0.97);
}

.result-fail {
    background-color: rgba(229, 151, 125, 0.97);
}

.result-perfect {
    background-color: rgba(247, 214, 125, 0.98);
}

.danger-pulse {
    border-color: rgba(191, 76, 58, 0.95);
    background-color: rgba(157, 94, 80, 0.68);
}

