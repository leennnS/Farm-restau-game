<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Fishing/fishing-hold-style.uss"/>
    <ui:VisualElement name="fishing-hold-panel" class="hold-panel">
        <!-- Header with fish name -->
        <ui:VisualElement name="hold-header" class="hold-header">
            <ui:Label name="catchable-name-label" text="???" class="fish-name"/>
        </ui:VisualElement>

        <!-- Main game area - moving fish -->
        <ui:VisualElement name="hold-game-area" class="game-area">
            <ui:VisualElement name="fish-container" class="fish-container">
                <ui:VisualElement name="fish-target" class="fish-target">
                    <ui:Label text="🐟" class="fish-emoji"/>
                </ui:VisualElement>
                <ui:VisualElement name="catch-zone" class="catch-zone">
                    <ui:Label text="○" class="catch-circle"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Hold progress bar -->
        <ui:VisualElement name="hold-progress-container" class="progress-container">
            <ui:Label name="hold-instruction" text="HOLD SPACEBAR!" class="instruction"/>
            <ui:ProgressBar name="hold-progress" class="hold-bar"/>
            <ui:Label name="hold-percentage" text="0%" class="percentage"/>
        </ui:VisualElement>

        <!-- Status text -->
        <ui:Label name="status-label" text="Get ready..." class="status"/>
    </ui:VisualElement>
</ui:UXML>
