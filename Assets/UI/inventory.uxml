<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="inventoryRoot" style="flex-grow: 1; align-items: center; justify-content: center;">
        <ui:VisualElement name="inventoryPanel" style="width: 572px; height: 440px; background-color: rgb(228, 183, 122); border-left-color: rgb(139, 90, 43); border-right-color: rgb(139, 90, 43); border-top-color: rgb(192, 138, 74); border-bottom-color: rgb(107, 63, 26); border-left-width: 4px; border-right-width: 4px; border-top-width: 4px; border-bottom-width: 4px; padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px; min-height: 440px;">
            <ui:VisualElement name="inventoryHeader" style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <ui:Label text="Inventory" name="Title" style="font-size: 18px; unity-font-style: bold; color: rgb(58, 42, 24);"/>
                <ui:Button name="closeButton" text="X" style="width: 26px; height: 26px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="inventoryTabs" style="flex-direction: row; margin-bottom: 8px; gap: 6px;">
                <ui:Button name="tabToolsButton" tooltip="Tools" style="width: 36px; height: 36px; background-color: rgb(214, 168, 107); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(122, 78, 42); border-right-color: rgb(122, 78, 42); border-top-color: rgb(183, 126, 62); border-bottom-color: rgb(92, 58, 27); background-size: contain; background-position: center; background-repeat: no-repeat; background-image: url(&quot;project://database/Assets/Art/Models/Farm/InventoryIcons/chef.png?fileID=2800000&amp;guid=4e9ff1eb3a15b1c4a9250d071b56d496&amp;type=3#chef&quot;);"/>
                <ui:Button name="tabCropsButton" tooltip="Crops" style="width: 36px; height: 36px; background-color: rgb(214, 168, 107); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(122, 78, 42); border-right-color: rgb(122, 78, 42); border-top-color: rgb(183, 126, 62); border-bottom-color: rgb(92, 58, 27); background-size: contain; background-position: center; background-repeat: no-repeat; background-image: url(&quot;project://database/Assets/Art/treasure-map.png?fileID=2800000&amp;guid=8c51cb2da6ed9e34bb4064cded81d6ca&amp;type=3#treasure-map&quot;);"/>
                <ui:Button name="tabCraftingButton" tooltip="Cooking" style="width: 36px; height: 36px; background-color: rgb(214, 168, 107); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(122, 78, 42); border-right-color: rgb(122, 78, 42); border-top-color: rgb(183, 126, 62); border-bottom-color: rgb(92, 58, 27); background-size: contain; background-position: center; background-repeat: no-repeat; background-image: url(&quot;project://database/Assets/Art/cogwheel.png?fileID=2800000&amp;guid=56a62a677ee29354c8af0689dfd1e769&amp;type=3#cogwheel&quot;);"/>
